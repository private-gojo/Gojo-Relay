{
  "log": {
    "loglevel": "debug",
    "access": "",
    "error": ""
  },
  "dns": {
    "servers": [
      "https://cloudflare-dns.com/dns-query",
      "https://dns.google/dns-query",
      "1.1.1.1",
      "8.8.8.8"
    ]
  },
  "inbounds": [
    {
      "tag": "vless-ws-in",
      "port": 10001,
      "listen": "0.0.0.0",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "GOJO_UUID_PLACEHOLDER",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "GOJO_PATH_PLACEHOLDER",
          "heartbeatPeriod": 0,
          "maxEarlyData": 2048,
          "earlyDataHeaderName": "Sec-WebSocket-Protocol"
        },
        "sockopt": {
          "tcpFastOpen": true,
          "tcpKeepAliveInterval": 15,
          "tcpKeepAliveIdle": 60,
          "tcpUserTimeout": 10000,
          "tcpcongestion": "bbr",
          "tcpMaxSeg": 1440,
          "trustedXForwardedFor": []
        }
      },
      "sniffing": {
        "enabled": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs"
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    },
    {
      "tag": "chain-trojan",
      "protocol": "trojan",
      "settings": {
        "servers": [
          {
            "address": "GOJO_IP_PLACEHOLDER",
            "port": "GOJO_PORT_PLACEHOLDER",
            "password": "GOJO_PASSWORD_PLACEHOLDER"
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "GOJO_SECURITY_PLACEHOLDER",
        "tlsSettings": {
          "allowInsecure": false
        },
        "wsSettings": {
          "path": "GOJO_XPATH_PLACEHOLDER",
          "headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
          }
        },
        "sockopt": {
          "tcpFastOpen": true,
          "tcpKeepAliveInterval": 15,
          "tcpKeepAliveIdle": 60,
          "tcpUserTimeout": 10000,
          "tcpcongestion": "bbr",
          "tcpMaxSeg": 1440
        }
      }
    },
    {
      "tag": "chain-vmess",
      "protocol": "vmess",
      "settings": {
