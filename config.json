  "routing": {
    "domainStrategy": "AsIs",
    "rules": []
  },
  "policy": {
    "levels": {
      "0": {
        "handshake": 15,
        "connIdle": 300,
        "uplinkOnly": 0,
        "downlinkOnly": 1,
        "bufferSize": 512
      }
    },
    "system": {
      "statsInboundUplink": false,
      "statsInboundDownlink": false,
      "statsOutboundUplink": false,
      "statsOutboundDownlink": false
