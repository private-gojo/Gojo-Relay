      "streamSettings": {
        "network": "ws",
        "security": "GOJO_SECURITY_PLACEHOLDER",
        "tlsSettings": {
          "allowInsecure": false
        },
        "wsSettings": {
          "path": "GOJO_XPATH_PLACEHOLDER",
